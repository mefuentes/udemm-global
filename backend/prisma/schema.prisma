generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Universidad {
  id         String     @id @default(uuid())
  nombre     String
  creadoEn   DateTime   @default(now())
  facultades Facultad[]
}

model Facultad {
  id            String      @id @default(uuid())
  nombre        String
  universidad   Universidad @relation(fields: [universidadId], references: [id])
  universidadId String
  carreras      Carrera[]
}

model Carrera {
  id          String       @id @default(uuid())
  nombre      String
  facultad    Facultad     @relation(fields: [facultadId], references: [id])
  facultadId  String
  planes      PlanEstudio[]
}

model PlanEstudio {
  id          String     @id @default(uuid())
  nombre      String
  carrera     Carrera    @relation(fields: [carreraId], references: [id])
  carreraId   String
  materias    Materia[]
}

model Materia {
  id            String      @id @default(uuid())
  codigo        String      @unique
  nombre        String
  creditos      Int
  planEstudio   PlanEstudio @relation(fields: [planEstudioId], references: [id])
  planEstudioId String
}

model Rol {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String?
  permisos    RolPermiso[]
  usuarios    Usuario[]
  fechaCreacion DateTime   @default(now())
}

model Permiso {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String?
  roles       RolPermiso[]
  fechaCreacion DateTime   @default(now())
}

model RolPermiso {
  id          String     @id @default(uuid())
  rol         Rol        @relation(fields: [rolId], references: [id])
  rolId       String
  permiso     Permiso    @relation(fields: [permisoId], references: [id])
  permisoId   String
  fechaCreacion DateTime @default(now())

  @@unique([rolId, permisoId])
}

model Usuario {
  id                String         @id @default(uuid())
  nombre            String
  apellido          String
  correoElectronico String         @unique
  contrasenaHash    String
  activo            Boolean        @default(true)
  fechaCreacion     DateTime       @default(now())
  fechaActualizacion DateTime      @updatedAt
  rol               Rol            @relation(fields: [rolId], references: [id])
  rolId             String
  sesiones          Sesion[]
  tokensRefresh     TokenRefresh[]
  docente           Docente?
}

model Sesion {
  id              String    @id @default(uuid())
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId       String
  ip              String?
  userAgent       String?
  activo          Boolean   @default(true)
  fechaCreacion   DateTime  @default(now())
  fechaActualizacion DateTime @updatedAt
}

model TokenRefresh {
  id             String    @id @default(uuid())
  token          String    @unique
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId      String
  expiracion     DateTime
  activo         Boolean   @default(true)
  fechaCreacion  DateTime  @default(now())
}

model Docente {
  id                    String    @id @default(uuid())
  nombre                String
  apellido              String
  tipoDocumento         String
  numeroDocumento       String    @unique
  correoElectronico     String    @unique
  sexo                  String?
  fechaNacimiento       DateTime?
  cuit                  String?
  telefono              String?
  calle                 String?
  numero                String?
  pisoDepto             String?
  residencia            String?
  provincia             String?
  localidad             String?
  codigoPostal          String?
  domicilio             String?
  tituloGrado           String?
  tituloPosgrado        String?
  cargoDeclarado        String?
  justificacionPertinencia String?
  actividadesProfesionales String?
  antecedentesAcademicos String?
  activo                Boolean   @default(true)
  fechaCreacion         DateTime  @default(now())
  fechaActualizacion    DateTime  @updatedAt
  usuario               Usuario?  @relation(fields: [usuarioId], references: [id])
  usuarioId             String?   @unique
}
