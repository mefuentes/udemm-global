# Variables de entorno para el backend de UDEMM Global.
# Copiar como backend/.env y completar con los valores reales del entorno.
# NUNCA commitear el archivo .env ni incluir valores reales en este archivo.
# Ver: docs/seguridad/FASE-S1-SEGURIDAD.md para instrucciones de configuración.

# ── Servidor ─────────────────────────────────────────────────────────────────

BACKEND_PORT=5000

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
# Ajustar host, puerto, nombre de base de datos y credenciales del entorno.

DATABASE_URL=postgresql://usuario:contrasena@localhost:5433/udemm_global

# ── JWT ───────────────────────────────────────────────────────────────────────
# JWT_SECRET es OBLIGATORIO. Debe tener al menos 32 caracteres y no puede ser
# un valor conocido o de ejemplo. Para generar uno seguro:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=REEMPLAZAR_CON_SECRETO_GENERADO_MINIMO_64_CARACTERES
JWT_EXPIRES_IN=3600s

# ── Refresh token ─────────────────────────────────────────────────────────────

REFRESH_TOKEN_EXPIRES_DAYS=30

# ── SMTP (para recuperación de contraseña) ────────────────────────────────────
# Opcional para arrancar el servidor. Requerido para la funcionalidad de email.

# SMTP_HOST=smtp.proveedor.com
# SMTP_PORT=587
# SMTP_USER=correo@dominio.edu.ar
# SMTP_PASS=contrasena_de_aplicacion_smtp
# SMTP_FROM="UDEMM Global" <no-reply@udemm.edu.ar>

# ── Entorno ───────────────────────────────────────────────────────────────────
# Valores permitidos: development | production | test

NODE_ENV=development
